# Copy to .env for deployment. Each installation uses its own data volume.
PIKMELO_IMAGE=ghcr.io/shenyunyao1/pikmelo-server:latest
PIKMELO_DATA_VOLUME=pikmelo-data
PIKMELO_BIND_ADDRESS=127.0.0.1
PIKMELO_PORT=8080
# Set the HTTPS origin when using a reverse proxy.
PIKMELO_PUBLIC_URL=
# Keep these defaults for new installations. Complete-backup imports can select
# their restored directory as described in deploy/docker.md.
PIKMELO_DATABASE=/data/data/library.sqlite
PIKMELO_MEDIA_ROOT=/data/media
