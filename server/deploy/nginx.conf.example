# Replace music.example.com with your public domain or certified public IP.
# The certificate name is fixed to musicserver in the Certbot examples.
server {
    listen 80 default_server;
    server_name music.example.com;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/musicserver-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 308 https://music.example.com$request_uri;
    }
}

server {
    listen 443 ssl http2 default_server;
    server_name music.example.com;
    ssl_certificate /etc/letsencrypt/live/musicserver/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/musicserver/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:musicserver_tls:10m;
    ssl_session_timeout 1d;
    server_tokens off;
    # Default application upload limit is 512 MiB plus multipart attachments.
    # Increase this as well if max_upload_bytes is raised in the application.
    client_max_body_size 544m;
    client_body_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
