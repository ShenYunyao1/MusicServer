# Copy to /etc/musicserver/musicserver.env and restrict it to root/musicserver.
# Generate a unique value for every deployment; do not commit the real file.
MUSIC_SERVER_API_KEY=replace-with-a-long-random-admin-key

# Optional: required when update_repository points to a private GitHub repo.
# MUSIC_SERVER_GITHUB_TOKEN=replace-with-a-read-only-github-token
